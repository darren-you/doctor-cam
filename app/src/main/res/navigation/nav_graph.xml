<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/UvcDevicesFragment">

    <fragment
        android:id="@+id/UvcDevicesFragment"
        android:name="cn.darrenyou.doctorcam.UvcDevicesFragment"
        android:label="@string/uvc_devices_fragment_label"
        tools:layout="@layout/fragment_uvc_devices">

        <!--    UVC相机预览    -->
        <action
            android:id="@+id/action_UvcDevicesFragment_to_UvcPreviewFragment"
            app:destination="@id/UvcPreviewFragment" />
        <!--    Onnx检测    -->
        <action
            android:id="@+id/action_UvcDevicesFragment_to_OnnxDetectionFragment"
            app:destination="@id/OnnxDetectionFragment" />
        <!--    PaddleLite检测    -->
        <action
            android:id="@+id/action_UvcDevicesFragment_to_PaddleDetectionFragment"
            app:destination="@id/PaddleDetectionFragment" />
    </fragment>

    <!--    UVC相机预览    -->
    <fragment
        android:id="@+id/UvcPreviewFragment"
        android:name="cn.darrenyou.doctorcam.UvcPreviewFragment"
        android:label="@string/uvc_preview_fragment_label"
        tools:layout="@layout/fragment_uvc_preview">

        <action
            android:id="@+id/action_UvcPreviewFragment_to_UvcDevicesFragment"
            app:destination="@id/UvcDevicesFragment" />
    </fragment>

    <!--    Onnx检测    -->
    <fragment
        android:id="@+id/OnnxDetectionFragment"
        android:name="cn.darrenyou.doctorcam.OnnxDetectionFragment"
        android:label="@string/onnx_detection_fragment_label"
        tools:layout="@layout/fragment_onnx_detection">
        <action
            android:id="@+id/action_OnnxDetectionFragment_to_UvcDevicesFragment"
            app:destination="@id/UvcDevicesFragment" />
    </fragment>

    <!--    PaddleLite检测    -->
    <fragment
        android:id="@+id/PaddleDetectionFragment"
        android:name="cn.darrenyou.doctorcam.PaddleDetectionFragment"
        android:label="@string/paddle_detection_fragment_label"
        tools:layout="@layout/fragment_paddle_detection">
        <action
            android:id="@+id/action_PaddleDetectionFragment_to_UvcDevicesFragment"
            app:destination="@id/UvcDevicesFragment" />
    </fragment>
</navigation>